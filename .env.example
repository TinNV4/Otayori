# ---- LINE (Messaging API channel) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF app id (e.g. 1234567890-AbCdEfGh). LIFF_CHANNEL_ID defaults to the part before "-".
LIFF_ID=
# Comma-separated LINE userIds allowed into the admin dashboard (send /whoami to the bot).
ADMIN_USER_IDS=

# ---- Claude ----
ANTHROPIC_API_KEY=
# Only if the key is organization-level (error: "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=

# ---- Service ----
# Public https URL of this service (used in ICS links and LINE replies).
PUBLIC_BASE_URL=http://localhost:3000
# memory | file (local JSON at .data/dev-db.json) | firestore
STORAGE=file
# Shared secret Cloud Scheduler sends to POST /tasks/cleanup
CRON_SECRET=

# ---- Beta limits ----
MAX_BETA_FAMILIES=20
DEFAULT_FAMILY_QUOTA=50
MONTHLY_BUDGET_USD=20
PUSH_LIMIT=200
MAX_PAGES_PER_DOC=6
AGGREGATION_WINDOW_MS=15000
RETENTION_DAYS=90
LEFT_GROUP_PURGE_DAYS=7
