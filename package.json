    "check": "tsc --noEmit && vitest run && vite build",
    "try-extract": "tsx scripts/try-extract.ts",
    "admin": "tsx scripts/admin.ts",
    "data": "tsx scripts/data.ts",
    "lens": "tsx scripts/lens.ts",
    "line:setup": "tsx scripts/line-setup.ts",
