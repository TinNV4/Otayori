  "version": "0.2.0-beta",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
